# Dockerfile.dev
FROM python:3.12-slim

# Variables de entorno
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV POETRY_HOME="/opt/poetry"
ENV PATH="$POETRY_HOME/bin:$PATH"

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    build-essential curl git libpq-dev sudo \
    && rm -rf /var/lib/apt/lists/*

# Instalar Poetry
RUN curl -sSL https://install.python-poetry.org | python3 - 
RUN poetry config virtualenvs.create false

# Crear usuario vscode
RUN useradd -m -s /bin/bash vscode && \
    echo "vscode ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Directorio de trabajo
WORKDIR /workspace
RUN chown -R vscode:vscode /workspace

# Cambiar al usuario vscode
USER vscode

# Copiar solo archivos de dependencias para instalar
COPY --chown=vscode:vscode backend/pyproject.toml backend/poetry.lock* ./backend/

# Instalar dependencias (no-root para desarrollo)
RUN cd backend && poetry install --no-root --no-interaction --no-ansi

# Copiar el resto del proyecto
COPY --chown=vscode:vscode . .

# Comando por defecto para desarrollo
CMD ["sleep", "infinity"]